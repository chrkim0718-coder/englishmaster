// AI integration for generating G-TELP grammar questions
// Supports both Gemini and Grok APIs

export interface GrammarQuestion {
  question_text: string
  option_a: string
  option_b: string
  option_c: string
  option_d: string
  correct_answer: "A" | "B" | "C" | "D"
  explanation: string
  grammar_type: string
  difficulty_level: "초급" | "중급" | "고급"
}

export async function generateGrammarQuestions(
  grammarType: string,
  difficultyLevel: "초급" | "중급" | "고급",
  count = 1,
): Promise<GrammarQuestion[]> {
  const aiProvider = process.env.AI_PROVIDER || 'gemini'
  
  if (aiProvider === 'grok') {
    return generateWithGrok(grammarType, difficultyLevel, count)
  } else if (aiProvider === 'lmstudio') {
    return generateWithLMStudio(grammarType, difficultyLevel, count)
  } else {
    return generateWithGemini(grammarType, difficultyLevel, count)
  }
}

async function generateWithGrok(
  grammarType: string,
  difficultyLevel: "초급" | "중급" | "고급",
  count = 1,
): Promise<GrammarQuestion[]> {
  const apiKey = process.env.GROK_API_KEY
  if (!apiKey) {
    throw new Error("GROK_API_KEY environment variable is not set")
  }

  const prompt = `영어 문법 문제를 ${count}개 생성해주세요.

요구사항:
- 문법 유형: ${grammarType}
- 난이도: ${difficultyLevel}
- 객관식 4지선다 문제
- 한국어 설명 포함

반드시 JSON 형식으로만 응답해주세요:
[
  {
    "question_text": "영어 문제 텍스트 (빈칸 _____로 표시)",
    "option_a": "선택지 A",
    "option_b": "선택지 B", 
    "option_c": "선택지 C",
    "option_d": "선택지 D",
    "correct_answer": "A",
    "explanation": "한국어 문법 설명",
    "grammar_type": "${grammarType}",
    "difficulty_level": "${difficultyLevel}"
  }
]`

  const response = await fetch('https://api.x.ai/v1/chat/completions', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${apiKey}`
    },
    body: JSON.stringify({
      messages: [
        {
          role: "system",
          content: "You are an expert English grammar teacher who creates Korean-language explanations for English grammar questions. Always respond with valid JSON format only."
        },
        {
          role: "user", 
          content: prompt
        }
      ],
      model: "grok-beta",
      temperature: 0.7,
      max_tokens: 2048
    })
  })

  if (!response.ok) {
    const errorText = await response.text()
    throw new Error(`Grok API error: ${response.status} ${response.statusText} - ${errorText}`)
  }

  const data = await response.json()
  console.log("Grok raw response:", data.choices[0].message.content)

  // Parse the response
  let responseText = data.choices[0].message.content.trim()
  
  // Remove markdown code blocks if present
  const jsonMatch = responseText.match(/```(?:json)?\s*([\s\S]*?)\s*```/)
  if (jsonMatch) {
    responseText = jsonMatch[1].trim()
  }

  console.log("Grok extracted JSON:", responseText)

  try {
    const questions = JSON.parse(responseText)
    return questions as GrammarQuestion[]
  } catch (error) {
    console.error("Grok JSON parse error:", error)
    throw new Error(`Failed to parse Grok response: ${error}`)
  }
}

async function generateWithLMStudio(
  grammarType: string,
  difficultyLevel: "초급" | "중급" | "고급",
  count = 1,
): Promise<GrammarQuestion[]> {
  const apiBase = process.env.LMSTUDIO_API_BASE
  if (!apiBase) {
    throw new Error("LMSTUDIO_API_BASE environment variable is not set")
  }

  // First, get available models
  let modelName = process.env.LMSTUDIO_MODEL_NAME || "local-model"
  try {
    const modelsResponse = await fetch(`${apiBase}/models`)
    if (modelsResponse.ok) {
      const modelsData = await modelsResponse.json()
      if (modelsData.data && modelsData.data.length > 0) {
        modelName = modelsData.data[0].id
        console.log("Using LM Studio model:", modelName)
      }
    }
  } catch (error) {
    console.warn("Could not fetch models from LM Studio, using default:", modelName)
  }

  const prompt = `Create ${count} English grammar questions about ${grammarType} (subjunctive mood) for beginner level.

Return ONLY this JSON array structure:
[
  {
    "question_text": "If I _____ you, I would study harder.",
    "option_a": "was",
    "option_b": "were", 
    "option_c": "am",
    "option_d": "is",
    "correct_answer": "B",
    "explanation": "가정법에서는 'were'를 사용합니다.",
    "grammar_type": "${grammarType}",
    "difficulty_level": "${difficultyLevel}"
  }
]

No other text, no thinking, just JSON.`

  const response = await fetch(`${apiBase}/chat/completions`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      model: modelName,
      messages: [
        {
          role: "system",
          content: "You are an expert English grammar teacher. You must respond with ONLY a valid JSON array, no explanations, no thinking process, no markdown. Just pure JSON."
        },
        {
          role: "user", 
          content: prompt
        }
      ],
      temperature: 0.3,
      max_tokens: 2048,
      stream: false
    })
  })

  if (!response.ok) {
    const errorText = await response.text()
    throw new Error(`LM Studio API error: ${response.status} ${response.statusText} - ${errorText}`)
  }

  const data = await response.json()
  console.log("LM Studio raw response:", data.choices[0].message.content)

  // Parse the response
  let responseText = data.choices[0].message.content.trim()
  
  // Remove thinking tags that DeepSeek models often include
  responseText = responseText.replace(/<think>[\s\S]*?<\/think>/g, '').trim()
  
  // Remove markdown code blocks if present
  const jsonMatch = responseText.match(/```(?:json)?\s*([\s\S]*?)\s*```/)
  if (jsonMatch) {
    responseText = jsonMatch[1].trim()
  }

  // Additional cleanup for DeepSeek models
  responseText = responseText.replace(/^[^[\{]*/, '').replace(/[^}\]]*$/, '').trim()

  console.log("LM Studio extracted JSON:", responseText)

  try {
    const questions = JSON.parse(responseText)
    return questions as GrammarQuestion[]
  } catch (error) {
    console.error("LM Studio JSON parse error:", error)
    // LM Studio 로컬 모델의 경우 더 유연한 파싱 시도
    try {
      // 더 강력한 JSON 추출 - 첫 번째 [ 부터 마지막 ] 까지
      const jsonStart = responseText.indexOf('[')
      const jsonEnd = responseText.lastIndexOf(']')
      
      if (jsonStart !== -1 && jsonEnd !== -1 && jsonEnd > jsonStart) {
        const extractedJson = responseText.substring(jsonStart, jsonEnd + 1)
        console.log("Extracted JSON with improved method:", extractedJson)
        const questions = JSON.parse(extractedJson)
        return questions as GrammarQuestion[]
      }
      
      // 대안: 개별 객체 추출 시도
      const objectMatches = responseText.match(/\{[^{}]*"question_text"[^{}]*\}/g)
      if (objectMatches && objectMatches.length > 0) {
        console.log("Found individual objects:", objectMatches)
        const questions = objectMatches.map((obj: string) => JSON.parse(obj))
        return questions as GrammarQuestion[]
      }
    } catch (secondError) {
      console.error("LM Studio second parse attempt failed:", secondError)
    }
    throw new Error(`Failed to parse LM Studio response: ${error}`)
  }
}

async function generateWithGemini(
  grammarType: string,
  difficultyLevel: "초급" | "중급" | "고급",
  count = 1,
): Promise<GrammarQuestion[]> {
  const apiKey = process.env.GEMINI_API_KEY
  if (!apiKey) {
    throw new Error("GEMINI_API_KEY environment variable is not set")
  }

  const prompt = `너는 G-TELP 문법 출제자야. [문법유형: ${grammarType}], [난이도: ${difficultyLevel}]에 맞는 4지선다형 영어 문법 문제를 ${count}문항 만들어줘. 

문장은 빈칸이 한 곳 있으며, 보기 4개와 정답, 간단한 해설도 함께 제공해줘. 

출력 형식은 아래와 같아:
문제: (빈칸이 있는 영어 문장)
보기: A. B. C. D.
정답: (정답 보기의 알파벳)
해설: (정답이 왜 맞는지 한 문장으로 간단히 설명)
문법유형: ${grammarType}
난이도: ${difficultyLevel}

응답은 반드시 다음과 같은 JSON 배열 형태로만 제공해줘:
[
  {
    "question_text": "She _____ to school every day.",
    "option_a": "go",
    "option_b": "goes", 
    "option_c": "going",
    "option_d": "gone",
    "correct_answer": "B",
    "explanation": "3인칭 단수 주어에는 현재시제 동사에 -s를 붙여 'goes'를 사용합니다.",
    "grammar_type": "${grammarType}",
    "difficulty_level": "${difficultyLevel}"
  }
]

G-TELP 시험 스타일에 맞게 실용적이고 정확한 문제를 만들어줘.`

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1/models/gemini-1.5-flash:generateContent?key=${apiKey}`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          contents: [
            {
              parts: [
                {
                  text: prompt,
                },
              ],
            },
          ],
          generationConfig: {
            temperature: 0.7,
            topK: 40,
            topP: 0.95,
            maxOutputTokens: 2048,
          },
        }),
      },
    )

    if (!response.ok) {
      const errorText = await response.text()
      throw new Error(`Gemini API error: ${response.status} ${response.statusText} - ${errorText}`)
    }

    const data = await response.json()
    const generatedText = data.candidates?.[0]?.content?.parts?.[0]?.text

    if (!generatedText) {
      throw new Error("No content generated from Gemini API")
    }

    // Extract JSON from the response (remove any markdown formatting)
    console.log("Gemini raw response:", generatedText)
    
    let jsonMatch = generatedText.match(/\[[\s\S]*\]/)
    if (!jsonMatch) {
      throw new Error("Could not extract JSON from Gemini response")
    }

    let cleanJsonText = jsonMatch[0]
    
    // Enhanced JSON cleaning for Korean text and quote issues
    console.log("Raw extracted JSON:", cleanJsonText)
    
    // CRITICAL: Ultra-aggressive quote normalization FIRST
    cleanJsonText = cleanJsonText
      // Step 0: Convert ALL single quotes to double quotes as the first step
      .replace(/'/g, '"')
      // Fix contractions that got broken by quote conversion
      .replace(/doesn"t/g, "doesn't")
      .replace(/won"t/g, "won't")
      .replace(/can"t/g, "can't")
      .replace(/isn"t/g, "isn't")
      .replace(/aren"t/g, "aren't")
      .replace(/wasn"t/g, "wasn't")
      .replace(/weren"t/g, "weren't")
      .replace(/doesn"t/g, "doesn't")
      .replace(/haven"t/g, "haven't")
      .replace(/hasn"t/g, "hasn't")
      .replace(/hadn"t/g, "hadn't")
      .replace(/shouldn"t/g, "shouldn't")
      .replace(/wouldn"t/g, "wouldn't")
      .replace(/couldn"t/g, "couldn't")
      // Now we only have double quotes, but some might be duplicated
      .replace(/""/g, '"')
      // Fix any doubled quotes from the conversion
      .replace(/""""/g, '""')
      .replace(/"""/g, '""')
    
    console.log("After quote normalization:", cleanJsonText)

    // Step 1: Fix the most common mixed quote patterns first
    cleanJsonText = cleanJsonText
      // At this point all quotes should be double quotes, just fix spacing and structure
      .replace(/"([a-z_]+)"\s*:\s*"([^"]*?)"/g, '"$1": "$2"')
      // Fix embedded quotes in explanation strings - escape them with space handling
      .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3 \\"$4\\" $5"$6')
      .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3 \\"$4\\" $5"$6')
      .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3"$4')
      .replace(/"explanation":\s*"([^"]*)"([^"]*)"([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\\"$2\\"$3\\"$4"$5')
      .replace(/"explanation":\s*"([^"]*)"([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\\"$2\\"$3"$4')
      .replace(/"explanation":\s*"([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\\"$2"$3')
      // Fix any remaining property syntax issues
      .replace(/"\s*([a-z_]+)\s*":/g, '"$1":')
      .replace(/:\s*"/g, ': "')
      // Fix the o'clock issue specifically (restore single quotes inside strings)
      .replace(/"o""clock/g, '"o\'clock"')
      .replace(/o""clock/g, 'o\'clock')
      // Fix quote corruption in Korean explanations (restore single quotes inside strings)
      .replace(/"([가-힣]+)""([가-힣]*)/g, '"$1\'$2')
      .replace(/([가-힣]+)""([가-힣]+)"/g, '$1\'$2"')
      .replace(/"([a-zA-Z]+)""([가-힣]+)/g, '"$1\'$2')
      .replace(/([가-힣]+)""([a-zA-Z]+)"/g, '$1\'$2"')
      // Fix common Korean word breaks
      .replace(/과거완\s*료/g, '과거완료')
      .replace(/구웠\s*을/g, '구웠을')
      .replace(/텐\s*데/g, '텐데')
      .replace(/입니\s*다/g, '입니다')
      .replace(/합니\s*다/g, '합니다')
      .replace(/되므\s*로/g, '되므로')
      .replace(/부적\s*절/g, '부적절')
      .replace(/적\s*절/g, '적절')
      .replace(/나타내\s*는/g, '나타내는')
      .replace(/표\s*면/g, '표면')
      .replace(/위\s*에/g, '위에')
      .replace(/있\s*다/g, '있다')
      .replace(/습\s*관/g, '습관')
      .replace(/규칙적\s*인/g, '규칙적인')
      .replace(/저\s*녁/g, '저녁')
      .replace(/의무\s*나/g, '의무나')
      .replace(/충고\s*를/g, '충고를')
      .replace(/지점이\s*나/g, '지점이나')
      .replace(/위치\s*를/g, '위치를')
      .replace(/과거\s*의/g, '과거의')
      .replace(/가정\s*을/g, '가정을')
      .replace(/미래\s*의/g, '미래의')
      .replace(/의지\s*를/g, '의지를')
      .replace(/능동적\s*인/g, '능동적인')
      .replace(/수동적\s*인/g, '수동적인')
      .replace(/객체이므\s*로/g, '객체이므로')
      // Remove line breaks that split words
      .replace(/([가-힣a-zA-Z])\s*\n\s*([가-힣a-zA-Z])/g, '$1$2')
      // Clean up whitespace
      .replace(/\s{2,}/g, ' ')
      .replace(/,\s*([}\]])/g, '$1')

    console.log("Cleaned JSON text:", cleanJsonText)

    let questions: GrammarQuestion[]
    try {
      questions = JSON.parse(cleanJsonText)
    } catch (parseError) {
      console.error("JSON parse error:", parseError)
      console.error("Failed JSON text:", cleanJsonText)
      
      // Step 2: More aggressive cleaning
      try {
        let finalClean = cleanJsonText
          // Additional quote fixes - more comprehensive
          .replace(/:\s*'([^']*?)"/g, ': "$1"')
          .replace(/:\s*"([^"]*?)'/g, ': "$1"')
          // Fix all mixed quote patterns more aggressively
          .replace(/"grammar_type":\s*'([^']*?)'/g, '"grammar_type": "$1"')
          .replace(/"difficulty_level":\s*'([^']*?)'/g, '"difficulty_level": "$1"')
          .replace(/"correct_answer":\s*'([^']*?)'/g, '"correct_answer": "$1"')
          .replace(/"question_text":\s*'([^']*?)'/g, '"question_text": "$1"')
          .replace(/"explanation":\s*'([^']*?)'/g, '"explanation": "$1"')
          .replace(/"option_a":\s*'([^']*?)'/g, '"option_a": "$1"')
          .replace(/"option_b":\s*'([^']*?)'/g, '"option_b": "$1"')
          .replace(/"option_c":\s*'([^']*?)'/g, '"option_c": "$1"')
          .replace(/"option_d":\s*'([^']*?)'/g, '"option_d": "$1"')
          // Fix explanation strings with embedded quotes with better space handling
          .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3 \\"$4\\" $5"$6')
          .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3"$4')
          .replace(/"explanation":\s*"([^"]*)"([^"]*)'([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\'$2\'$3\'$4"$5')
          .replace(/"explanation":\s*"([^"]*)'([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\'$2\'$3"$4')
          // Remove line breaks in strings
          .replace(/"explanation":\s*"([^"]*(?:\n[^"]*)*)"([,}])/g, (match: string, explanation: string, suffix: string) => {
            const cleanExplanation = explanation.replace(/\n\s*/g, ' ').replace(/\s+/g, ' ').trim()
            return `"explanation": "${cleanExplanation}"${suffix}`
          })
          .replace(/"question_text":\s*"([^"]*(?:\n[^"]*)*)"([,}])/g, (match: string, text: string, suffix: string) => {
            const cleanText = text.replace(/\n\s*/g, ' ').replace(/\s+/g, ' ').trim()
            return `"question_text": "${cleanText}"${suffix}`
          })

        console.log("Final cleaned JSON:", finalClean)
        questions = JSON.parse(finalClean)
      } catch (secondError) {
        console.error("Second parse attempt failed:", secondError)
        console.error("Second attempt JSON text (last 500 chars):", cleanJsonText.slice(-500))
        
        // Step 3: Last resort manual reconstruction with even more aggressive fixes
        try {
          console.log("Attempting manual JSON reconstruction...")
          let reconstructed = cleanJsonText
            // Start with complete quote normalization
            .replace(/"/g, '"')  // Normalize all curly quotes
            .replace(/"/g, '"')
            .replace(/'/g, "'")  // Normalize all single quotes
            .replace(/'/g, "'")
            // Remove any potential BOM or hidden characters
            .replace(/^\uFEFF/, '')
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            // Fix all property names to use double quotes
            .replace(/'([a-z_]+)':/g, '"$1":')
            .replace(/'([a-z_]+)":/g, '"$1":')
            .replace(/"([a-z_]+)':/g, '"$1":')
            // Comprehensive value quote fixes with more patterns
            .replace(/"grammar_type":\s*'([^']*?)'/g, '"grammar_type": "$1"')
            .replace(/"difficulty_level":\s*'([^']*?)'/g, '"difficulty_level": "$1"')
            .replace(/"correct_answer":\s*'([^']*?)'/g, '"correct_answer": "$1"')
            .replace(/"question_text":\s*'([^']*?)'/g, '"question_text": "$1"')
            .replace(/"explanation":\s*'([^']*?)'/g, '"explanation": "$1"')
            .replace(/"option_a":\s*'([^']*?)'/g, '"option_a": "$1"')
            .replace(/"option_b":\s*'([^']*?)'/g, '"option_b": "$1"')
            .replace(/"option_c":\s*'([^']*?)'/g, '"option_c": "$1"')
            .replace(/"option_d":\s*'([^']*?)'/g, '"option_d": "$1"')
            // Fix remaining mixed quotes patterns - any pattern
            .replace(/:\s*'([^']*?)'/g, ': "$1"')
            .replace(/:\s*"([^"]*?)'/g, ': "$1"')
            // Handle very complex embedded quotes by escaping them
            .replace(/:\s*"([^"]*)"([^"]*)"([^"]*)"(\s*[,}])/g, ': "$1\\"$2\\"$3"$4')
            .replace(/:\s*"([^"]*)'([^"]*)'([^"]*)"(\s*[,}])/g, ': "$1\\"$2\\"$3"$4')
            .replace(/:\s*"([^"]*)"([^"]*)'([^"]*)"(\s*[,}])/g, ': "$1\\"$2\\"$3"$4')
            // Fix broken object/array syntax
            .replace(/}\s*{/g, '}, {')
            .replace(/]\s*\[/g, '], [')
            // Remove all line breaks within strings first
            .replace(/"explanation":\s*"([^"]*(?:\n[^"]*)*)"([,}])/g, (match: string, explanation: string, suffix: string) => {
              const cleanExplanation = explanation.replace(/\n\s*/g, ' ').replace(/\s+/g, ' ').trim()
              return `"explanation": "${cleanExplanation}"${suffix}`
            })
            .replace(/"question_text":\s*"([^"]*(?:\n[^"]*)*)"([,}])/g, (match: string, text: string, suffix: string) => {
              const cleanText = text.replace(/\n\s*/g, ' ').replace(/\s+/g, ' ').trim()
              return `"question_text": "${cleanText}"${suffix}`
            })
            // Remove all remaining line breaks
            .replace(/\n/g, ' ')
            // Normalize all whitespace aggressively
            .replace(/\s+/g, ' ')
            // Fix property spacing
            .replace(/"\s*:/g, '":')
            .replace(/:\s*/g, ': ')
            // Fix comma spacing
            .replace(/,\s*/g, ', ')
            .replace(/,\s*}/g, '}')
            .replace(/,\s*]/g, ']')
            // Fix any remaining syntax issues
            .replace(/,(\s*[}\]])/g, '$1')
            .replace(/([}\]])(\s*)([{\[])/g, '$1,$2$3')
            // Clean up extra spaces
            .trim()

          console.log("Reconstructed JSON:", reconstructed)
          questions = JSON.parse(reconstructed)
        } catch (thirdError) {
          console.error("Manual reconstruction failed:", thirdError)
          console.error("Final JSON attempt (last 500 chars):", cleanJsonText.slice(-500))
          
          // Step 4: Absolute last resort - try to extract individual question objects
          try {
            console.log("Attempting individual object extraction...")
            const objectMatches = cleanJsonText.match(/\{[^{}]*"grammar_type"[^{}]*\}/g)
            if (objectMatches && objectMatches.length > 0) {
              console.log(`Found ${objectMatches.length} potential question objects`)
              const extractedQuestions: GrammarQuestion[] = []
              
              for (const objectMatch of objectMatches) {
                try {
                  // Clean each object individually with very aggressive fixes
                  let cleanObject = objectMatch
                    // Fix all quote types first
                    .replace(/'/g, '"')  // Convert all single quotes to double
                    .replace(/"/g, '"')  // Normalize all quotes
                    .replace(/"/g, '"')  
                    // Fix contractions that got broken by quote conversion
                    .replace(/doesn"t/g, "doesn't")
                    .replace(/won"t/g, "won't")
                    .replace(/can"t/g, "can't")
                    .replace(/isn"t/g, "isn't")
                    .replace(/aren"t/g, "aren't")
                    .replace(/wasn"t/g, "wasn't")
                    .replace(/weren"t/g, "weren't")
                    .replace(/haven"t/g, "haven't")
                    .replace(/hasn"t/g, "hasn't")
                    .replace(/hadn"t/g, "hadn't")
                    .replace(/shouldn"t/g, "shouldn't")
                    .replace(/wouldn"t/g, "wouldn't")
                    .replace(/couldn"t/g, "couldn't")
                    // Fix any remaining mixed quote patterns
                    .replace(/"([a-z_]+)":\s*'([^']*?)'/g, '"$1": "$2"')
                    .replace(/'([a-z_]+)':\s*"([^"]*?)"/g, '"$1": "$2"')
                    .replace(/"\s*([a-z_]+)\s*":/g, '"$1":')  // Fix property names
                    .replace(/:\s*"([^"]*?)'/g, ': "$1"')  // Fix mixed quotes
                    .replace(/:\s*'([^']*?)"/g, ': "$1"')  // Fix mixed quotes reverse
                    // Handle embedded quotes in explanation by escaping - enhanced with space handling
                    .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3 \\"$4\\" $5"$6')
                    .replace(/"explanation":\s*"([^"]*?)\s*"([^"]+?)"\s*([^"]*?)"(\s*[,}])/g, '"explanation": "$1 \\"$2\\" $3"$4')
                    .replace(/"explanation":\s*"([^"]*)"([^"]*)"([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\\"$2\\"$3\\"$4"$5')
                    .replace(/"explanation":\s*"([^"]*)"([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\\"$2\\"$3"$4')
                    .replace(/"explanation":\s*"([^"]*)"([^"]*)"(\s*[,}])/g, '"explanation": "$1\\"$2"$3')
                    .replace(/\n/g, ' ')  // Remove line breaks
                    .replace(/\s+/g, ' ')  // Normalize spaces
                  
                  console.log("Attempting to parse individual object:", cleanObject)
                  const parsed = JSON.parse(cleanObject)
                  
                  // Validate required fields
                  if (parsed.grammar_type && parsed.question_text && parsed.option_a && 
                      parsed.option_b && parsed.option_c && parsed.option_d && 
                      parsed.correct_answer && parsed.explanation && parsed.difficulty_level) {
                    extractedQuestions.push(parsed)
                    console.log(`Successfully extracted question for ${parsed.grammar_type}`)
                  }
                } catch (objectError) {
                  console.log("Failed to parse individual object:", objectError)
                  console.log("Object content:", objectMatch.slice(0, 200))
                }
              }
              
              if (extractedQuestions.length > 0) {
                console.log(`Successfully extracted ${extractedQuestions.length} questions via individual parsing`)
                questions = extractedQuestions
              } else {
                throw new Error("No valid questions could be extracted from any parsing method")
              }
            } else {
              throw new Error("No question objects found in response")
            }
          } catch (finalError) {
            console.error("All parsing methods failed:", finalError)
            throw new Error(`Failed to parse JSON from Gemini response after all attempts: ${parseError}`)
          }
        }
      }
    }

    // Validate the questions
    questions.forEach((q, index) => {
      if (
        !q.question_text ||
        !q.option_a ||
        !q.option_b ||
        !q.option_c ||
        !q.option_d ||
        !q.correct_answer ||
        !q.explanation ||
        !q.grammar_type ||
        !q.difficulty_level
      ) {
        throw new Error(`Invalid question format at index ${index}`)
      }

      if (!["A", "B", "C", "D"].includes(q.correct_answer)) {
        throw new Error(`Invalid correct_answer at index ${index}: ${q.correct_answer}`)
      }

      if (!["초급", "중급", "고급"].includes(q.difficulty_level)) {
        throw new Error(`Invalid difficulty_level at index ${index}: ${q.difficulty_level}`)
      }
    })

    return questions
  } catch (error) {
    console.error("Error generating G-TELP questions with Gemini:", error)
    throw error
  }
}
